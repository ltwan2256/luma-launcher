+}
+impl LumaWriter {
+    fn new(writer: Arc<Mutex<Option<ConnWriter>>>, configuring: Arc<AtomicBool>) -> Option<Self> {
+        let (sender, receive) = channel::<Vec<u8>>();
+        let pending = Arc::new(AtomicUsize::new(0));
+        let count = pending.clone();
+        std::thread::Builder::new().name("luma-orbital-send".into()).spawn(move || {
+            for packet in receive {
+                let n = packet.len();
+                let failed = {
+                    let mut guard = writer.lock().unwrap();
+                    if configuring.load(Ordering::Relaxed) { false }
+                    else if let Some(w) = guard.as_mut() {
+                        if w.send(&packet).is_err() { w.shutdown(); true } else { false }
+                    } else { true }
+                };
+                count.fetch_sub(n, Ordering::Relaxed);
+                if failed { break; }
+            }
+        }).ok()?;
+        Some(Self { sender, pending })
+    }
+    fn enqueue(&self, packet: Vec<u8>) -> bool {
+        let n = packet.len();
+        if self.pending.fetch_add(n, Ordering::Relaxed) + n > 32 * 1024 * 1024 {
+            self.pending.fetch_sub(n, Ordering::Relaxed);
+            return false;
+        }
+        if self.sender.send(packet).is_err() {
+            self.pending.fetch_sub(n, Ordering::Relaxed);
+            return false;
+        }
+        true
+    }
+}
